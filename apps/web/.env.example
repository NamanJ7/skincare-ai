# Server-only. A missing key returns an explicit unconfigured analysis result;
# it never substitutes mock scan findings.
ANTHROPIC_API_KEY=

# Supabase (server-side). These are REQUIRED for /api/plan: the endpoint spends
# two Opus calls per request, so it verifies a real bearer token and debits a
# durable per-user quota before invoking the model. Unset means every analysis
# request is refused with 503 — it does not fall back to unmetered access.
# The service-role key is server-only and must never appear in a client bundle.
# SUPABASE_URL is validated before use (lib/safe-url.ts): it must be https and
# must not point at loopback, private, or link-local space, because it is the
# base for requests that carry a project key. An unsafe value is treated as
# unconfigured rather than as a host to send credentials to.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Preferred for token verification (GET /auth/v1/user). That call authenticates
# with the caller's own bearer token, so `apikey` only needs to identify the
# project — sending the service-role key there ships far more privilege than the
# call requires. Service-role is used as a fallback when this is unset.
SUPABASE_ANON_KEY=

# Salt for the hashed client IP recorded in the analysis audit trail. Set to any
# long random string. Raw addresses are never stored.
IP_HASH_SALT=

# Number of proxies you actually operate in front of the app. 1 is correct on
# Vercel. Only hops contributed by your own infrastructure are trustworthy —
# see trustedClientIp in lib/rate-limit.ts.
TRUSTED_PROXY_HOPS=1

# Set to "true" only if you run an edge that guarantees it rewrites
# `x-vercel-forwarded-for` / `x-real-ip` on every inbound request. On Vercel the
# platform's own VERCEL=1 already covers this. Off-platform these headers are
# plain caller-supplied text, and trusting them lets a caller mint fresh rate
# buckets and choose the ip_hash recorded in their own audit trail.
# TRUST_PLATFORM_FORWARDED_HEADER=true

# DEVELOPMENT / PREVIEW ONLY. Comma-separated exact origins permitted to call
# the API from a browser (e.g. the Expo web preview). Unset — the production
# default — means no Access-Control-Allow-* header is ever emitted and preflights
# are refused, which is the correct posture: auth is a bearer header, never a
# cookie, so the API is structurally CSRF-immune with no CORS policy at all.
# `*` is refused by lib/cors.ts even if you put it here.
# ALLOWED_ORIGINS=http://127.0.0.1:8104

# LOCAL DEVELOPMENT ONLY. Runs /api/plan without authentication or quota so the
# pipeline can be exercised without a Supabase project. Ignored when
# NODE_ENV=production, and every request it permits is logged as a warning.
# Leave unset unless you are deliberately testing locally.
# ALLOW_UNAUTHENTICATED_ANALYSIS=true
