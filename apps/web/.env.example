# Set this to enable the real Claude-powered pipeline. When unset, /api/plan
# returns a deterministic mock so the full flow still works end-to-end.
ANTHROPIC_API_KEY=

# --- Parental consent (16-17 year olds) --------------------------------------
# All three are required before a minor can capture photos. The flow FAILS
# CLOSED: with any of them missing the consent routes error, no approval is ever
# recorded, and apps/mobile/src/app/onboarding/photo.tsx keeps the camera shut.

# Signs the consent tokens and derives the approval code. There is no database:
# this secret is the only thing standing between a guessed URL and an approval.
# Must be at least 32 characters. Generate with: openssl rand -base64 48
CONSENT_SECRET=

# Resend API key, used to email the parent the approval link.
RESEND_API_KEY=
# Verified sender for that email, e.g. "Pore <consent@yourdomain.com>".
CONSENT_EMAIL_FROM=

# Origin used to build the approval link in the email. Defaults to the incoming
# request's origin, which is wrong behind a proxy or when the app calls a
# different host than the one that serves the page — set it explicitly in
# production, e.g. https://poreai.vercel.app
CONSENT_APP_ORIGIN=
