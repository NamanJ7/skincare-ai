# Set this to enable the real Claude-powered pipeline. When unset, /api/plan
# returns a deterministic mock so the full flow still works end-to-end.
ANTHROPIC_API_KEY=

# Parental-consent gate (apps/web/lib/consent.ts) for under-18 users.
#
# Postgres connection string (e.g. a Neon database). When unset, consent
# requests are kept in an in-memory Map instead -- fine for local dev, but it
# means requests are lost on every server restart/redeploy and never shared
# across serverless instances. Set this before relying on the gate for real.
DATABASE_URL=

# Resend API key used to email the parent an approve/deny link. When unset,
# the email is logged to the server console instead of being sent, so the
# flow is still testable end-to-end without an account.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Pore <onboarding@resend.dev>"

# Absolute origin used to build the approval link sent to parents (must be
# reachable by the parent's browser, not the app). Defaults to localhost.
APP_BASE_URL=http://localhost:3000
