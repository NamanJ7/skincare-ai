# All EXPO_PUBLIC_* vars are baked into the client bundle at build time.
# Every one is optional: unset means that integration runs in placeholder
# mode and the app behaves exactly like the local-only beta.

# Required for real scan analysis. On a physical device, use a reachable HTTPS
# host or your development machine's LAN address. When omitted, Pore fails
# closed and labels the routine as answer-based.
EXPO_PUBLIC_API_URL=https://api.example.com

# Supabase accounts + cloud backup. Unset = sign-in shows the honest
# "account sync is not enabled" placeholder.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
